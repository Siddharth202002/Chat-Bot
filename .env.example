# Copy to .env and fill in real values. .env is gitignored -- never commit keys.
# The backend loads ../.env (repo root) or chatbot/.env, whichever exists.

# --- Required ---------------------------------------------------------------
GROQ_API_KEY=
JINA_API_KEY=
JWT_SECRET_KEY=

# --- Conversational model (Groq) -------------------------------------------
GROQ_MODEL=openai/gpt-oss-120b
ASSISTANT_NAME=Zeno AI

# --- Long-term memory: Mistral extraction -----------------------------------
# Mistral is used ONLY to extract long-term memories from recent messages.
# It is never on the chat response path -- if it fails, chat is unaffected.
MISTRAL_API_KEY=
MISTRAL_MEMORY_MODEL=ministral-8b-latest
MISTRAL_MEMORY_TIMEOUT=20
# 429 (rate limit) and 5xx are retried off the response path.
MISTRAL_MEMORY_MAX_ATTEMPTS=3
MISTRAL_MEMORY_RETRY_BASE_DELAY=1.5

# --- Long-term memory: behaviour --------------------------------------------
MEMORY_EXTRACTION_ENABLED=true
# User messages between extractions; 1 = extract after every user message.
# This is the ONLY trigger (no phrase matching), so it alone sets call volume.
# Raise it to cut calls, at the cost of slower recall of a new fact.
MEMORY_EXTRACTION_INTERVAL=1
# How many recent messages are sent to Gemini. Never the whole conversation.
MEMORY_EXTRACTION_WINDOW=10
# How many memories are injected into a chat prompt.
MEMORY_RETRIEVAL_TOP_K=5
# Cosine floor for relevance. Jina v3 scores short memories in a low band:
# a correct "what is my job" match measures ~0.23, so 0.30 rejected real hits.
MEMORY_RETRIEVAL_MIN_SCORE=0.10
# >= dedup -> already known, skip.  >= update -> rewrite the existing memory.
MEMORY_DEDUP_THRESHOLD=0.95
MEMORY_UPDATE_THRESHOLD=0.82
MEMORY_MAX_PER_EXTRACTION=8
MEMORY_MAX_CONTENT_CHARS=400
MEMORY_MAX_PER_USER=500

# --- Optional tools ---------------------------------------------------------
FINNHUB_API_KEY=
MCP_SPENDING_ANALYZER_SCRIPT=
MCP_UV_COMMAND=uv

# --- Optional embeddings tuning ---------------------------------------------
JINA_EMBEDDINGS_MODEL=jina-embeddings-v3
JINA_EMBEDDINGS_BATCH_SIZE=32
JINA_EMBEDDINGS_TIMEOUT=30

# --- Optional auth / CORS ---------------------------------------------------
JWT_EXP_SECONDS=86400
AUTH_COOKIE_SECURE=false
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Optional tracing -------------------------------------------------------
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
