# Copy to .env and fill in real values. .env is gitignored -- never commit keys.
# The backend loads ../.env (repo root) or chatbot/.env, whichever exists.

# --- Required ---------------------------------------------------------------
GROQ_API_KEY=
JINA_API_KEY=
JWT_SECRET_KEY=

# --- Conversational model (Groq) -------------------------------------------
GROQ_MODEL=openai/gpt-oss-120b
ASSISTANT_NAME=Zeno AI
# Sampling. Temperature was 0, but greedy decoding makes gpt-oss-120b prone to
# repetition loops -- it emits runs of "...", "Sorry...", "Oops..." and
# no-break spaces before recovering and printing the real answer, which the
# user sees as junk above their reply. A little sampling plus a frequency
# penalty makes that far rarer and much shorter when it does happen; both are
# kept low so tool-call arguments stay effectively deterministic.
# GROQ_MAX_TOKENS bounds the damage if a loop starts anyway.
GROQ_TEMPERATURE=0.2
GROQ_FREQUENCY_PENALTY=0.3
GROQ_MAX_TOKENS=2048

# --- Fallback chat providers -------------------------------------------------
# Chat walks this chain in order and moves to the next provider whenever one
# fails -- a 429/402/5xx/dropped connection all count. Groq's free tier has a
# daily token cap, and hitting it used to stop the assistant answering at all.
# A provider whose key is unset is skipped, so the chain can be left as-is.
# Mid-stream failures retract any partial text before the next provider starts,
# so a half answer never sits above a whole one.
LLM_PROVIDER_CHAIN=groq,groq-alt,groq-alt2,gemini
# Groq meters its free tier per MODEL ("Rate limit reached for model X ... on
# tokens per day"), so groq-alt / groq-alt2 are the same key on different
# models and each has its own daily budget. They are the fastest links in the
# chain, so they are tried before any other provider.
GROQ_ALT_MODEL=openai/gpt-oss-20b
GROQ_ALT2_MODEL=qwen/qwen3.8-27b
# Leave this at 0. The Groq SDK otherwise retries a 429 twice AND honours
# Retry-After up to 60s, so a rate-limited request sleeps ~30s inside the
# client and never raises -- the fallback chain below is then never reached.
# One measured turn took 41s with 34s of it spent asleep. The chain IS the
# retry strategy, and retrying a daily quota cannot succeed anyway.
GROQ_MAX_RETRIES=0
GROQ_TIMEOUT=30
# Gemini (https://aistudio.google.com/apikey). GEMINI_API_KEY also works.
# Gemini Flash-Lite is reserved for conversation summarization
# (CONTEXT_SUMMARY_MODEL below), so `gemini-lite` is not in the chat chain or
# the model picker. Adding it back to LLM_PROVIDER_CHAIN re-enables it for chat.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-flash-lite-latest
# The Google SDK retries a 429 five times with backoff by default, which costs
# ~30s of silence before the chain can move on. The chain is the retry strategy.
GEMINI_MAX_RETRIES=1
# OpenRouter (https://openrouter.ai/keys), reached over its OpenAI-compatible
# endpoint via langchain-openai, so it needs no extra package.
#
# NOT in LLM_PROVIDER_CHAIN above: nvidia/nemotron-3.5-lightning:free writes its
# whole chain-of-thought into the answer ("Here's a thinking process: 1.
# **Analyze User Input:** ..."), quoting the system prompt back at the user, and
# OpenRouter has no equivalent of Groq's reasoning_format to turn it off. Add
# "openrouter" to the chain to switch it back on.
#
# The model MUST advertise tool support or the assistant cannot call its tools
# -- list the free ones with:
#   curl -s https://openrouter.ai/api/v1/models #     | jq -r '.data[] | select(.id|endswith(":free"))
#              | select(.supported_parameters|index("tools")) | .id'
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# --- Long-term memory: Mistral extraction -----------------------------------
# Mistral is used ONLY to extract long-term memories from recent messages.
# It is never on the chat response path -- if it fails, chat is unaffected.
MISTRAL_API_KEY=
MISTRAL_MEMORY_MODEL=ministral-8b-latest
MISTRAL_MEMORY_TIMEOUT=20
# 429 (rate limit) and 5xx are retried off the response path.
MISTRAL_MEMORY_MAX_ATTEMPTS=3
MISTRAL_MEMORY_RETRY_BASE_DELAY=1.5

# --- Long-term memory: behaviour --------------------------------------------
MEMORY_EXTRACTION_ENABLED=true
# User messages between extractions; 1 = extract after every user message.
# This is the ONLY trigger (no phrase matching), so it alone sets call volume.
# Raise it to cut calls, at the cost of slower recall of a new fact.
MEMORY_EXTRACTION_INTERVAL=1
# How many recent messages are sent to Gemini. Never the whole conversation.
MEMORY_EXTRACTION_WINDOW=10
# How many memories are injected into a chat prompt.
MEMORY_RETRIEVAL_TOP_K=5
# Cosine floor for relevance. Jina v3 scores short memories in a low band:
# a correct "what is my job" match measures ~0.23, so 0.30 rejected real hits.
MEMORY_RETRIEVAL_MIN_SCORE=0.10
# >= dedup -> already known, skip.  >= update -> rewrite the existing memory.
MEMORY_DEDUP_THRESHOLD=0.95
MEMORY_UPDATE_THRESHOLD=0.82
MEMORY_MAX_PER_EXTRACTION=8
MEMORY_MAX_CONTENT_CHARS=400
MEMORY_MAX_PER_USER=500

# --- Conversation compression (rolling summary) -----------------------------
# Old turns are folded into one rolling summary once the projected prompt
# (system + tools + summary + recent messages + reply reserve) reaches the
# trigger. All values are estimated tokens. The summarizer is internal: the
# user's model picker never changes it. Uses GOOGLE_API_KEY.
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_BUDGET=16000
CONTEXT_COMPRESSION_TRIGGER=12000
CONTEXT_RECENT_MESSAGE_COUNT=10
CONTEXT_SUMMARY_TARGET_TOKENS=2500
CONTEXT_SUMMARY_MAX_TOKENS=3000
CONTEXT_OUTPUT_RESERVE_TOKENS=4000
CONTEXT_SAFETY_MARGIN_TOKENS=2000
CONTEXT_MAX_COMPRESSION_ATTEMPTS=1
CONTEXT_SUMMARY_PROVIDER=gemini
CONTEXT_SUMMARY_MODEL=gemini-flash-lite-latest
# Optional second summarizer ("gemini" or "groq"); empty = none.
CONTEXT_SUMMARY_FALLBACK_PROVIDER=
CONTEXT_SUMMARY_FALLBACK_MODEL=
CONTEXT_SUMMARY_TIMEOUT=20
# After every summarizer fails, skip folding for this many seconds.
CONTEXT_SUMMARY_FAILURE_COOLDOWN=60
# "heuristic" (default, offline) or "tiktoken" (o200k; may download once).
CONTEXT_TOKENIZER=heuristic

# --- Location + weather -----------------------------------------------------
# Reverse/forward geocoding uses the public OpenStreetMap Nominatim service,
# which needs no key but DOES require an identifying User-Agent and allows at
# most one request per second. Set NOMINATIM_CONTACT (a URL or email) so the
# derived User-Agent identifies this deployment, or override the whole string
# with NOMINATIM_USER_AGENT.
NOMINATIM_CONTACT=
# NOMINATIM_USER_AGENT=ZenoAI-Chatbot/1.0 (+https://example.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT=10
NOMINATIM_MIN_INTERVAL=1.1
GEOCODE_CACHE_TTL=86400
GEOCODE_CACHE_MAX_ENTRIES=512
# Decimals in the reverse-geocode cache key (3 = ~110 m, so one neighbourhood
# is one upstream request).
GEOCODE_COORD_PRECISION=3

# Weather provider. `openweather` needs OPENWEATHER_API_KEY (free tier is
# enough: the 2.5 /weather and /forecast endpoints, not One Call 3.0).
# `open-meteo` needs no key and is used automatically if the key is missing.
# The key is server-side only and is never sent to the frontend.
WEATHER_PROVIDER=openweather
OPENWEATHER_API_KEY=
OPENWEATHER_UNITS=metric
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT=10
WEATHER_CACHE_TTL=600

# Stored user location. Coordinates are rounded to LOCATION_STORE_PRECISION
# decimals (2 = ~1.1 km) before being written, and the row expires after
# LOCATION_TTL_SECONDS so a stale position never follows a user to a new city.
LOCATION_STORE_PRECISION=2
LOCATION_TTL_SECONDS=3600
# Resolves an IANA timezone name for a coordinate via the keyless Open-Meteo
# endpoint. Best-effort and cached; set false to skip it entirely.
LOCATION_TIMEZONE_LOOKUP=true
TIMEZONE_LOOKUP_URL=https://api.open-meteo.com/v1/forecast

# --- Web search -------------------------------------------------------------
# ddgs defaults to backend="auto", which fans every query across all eight
# engines; most of that is latency spent on failures (google and mojeek 403 on
# some hosts). Pin a short list instead. Valid engines: brave, duckduckgo,
# google, grokipedia, mojeek, wikipedia, yahoo, yandex.
SEARCH_BACKENDS=duckduckgo, brave, yahoo
# NOT the "wt-wt" default: that is not a real locale, and it builds malformed
# URLs (hl=wt-WT, wt.wikipedia.org) that fail before returning anything.
SEARCH_REGION=in-en
SEARCH_MAX_RESULTS=4

# --- Optional tools ---------------------------------------------------------
FINNHUB_API_KEY=
MCP_SPENDING_ANALYZER_SCRIPT=
MCP_UV_COMMAND=uv

# --- Optional embeddings tuning ---------------------------------------------
JINA_EMBEDDINGS_MODEL=jina-embeddings-v3
JINA_EMBEDDINGS_BATCH_SIZE=32
JINA_EMBEDDINGS_TIMEOUT=30

# --- Optional auth / CORS ---------------------------------------------------
JWT_EXP_SECONDS=86400
AUTH_COOKIE_SECURE=false
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Optional tracing -------------------------------------------------------
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
